{
  "name": "bayt",
  "version": "0.1.0",
  "private": true,
  "description": "BAYT — plateforme d'apprentissage assistee par IA (monorepo)",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @bayt/api dev",
    "dev:web": "pnpm --filter @bayt/web dev",
    "db:reset": "pnpm --filter @bayt/api db:reset:local",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "pnpm run build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
