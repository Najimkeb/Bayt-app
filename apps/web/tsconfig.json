{
  "extends": "@bayt/config/tsconfig.react.json",
  "compilerOptions": {
    /* Next.js impose sa propre resolution (bundler) et transforme le JSX
       lui-meme : on s'ecarte ici de la base NodeNext du monorepo. */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    /* Next.js remplace litteralement `process.env.NEXT_PUBLIC_*` a la
       compilation : la notation par crochets ne serait pas substituee. */
    "noPropertyAccessFromIndexSignature": false,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
