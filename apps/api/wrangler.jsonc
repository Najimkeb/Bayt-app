{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayt-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // Base D1 du contexte « Learning Engine ».
  // `database_id` n'est utilise qu'en remote : en local, wrangler cree une base
  // SQLite sous .wrangler/state/ — aucun compte Cloudflare requis.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bayt",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],

  // R2 : stockage des documents source bruts. En local, wrangler simule le
  // bucket sous .wrangler/state/ — aucun compte Cloudflare requis.
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "bayt-documents"
    }
  ],

  // Queues : traitement asynchrone de l'ingestion, hors du chemin critique.
  // Le même Worker est producteur (POST /documents) et consommateur (queue()).
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "bayt-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "bayt-ingestion",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  // Workers AI (optionnel) : décommenter pour brancher le vrai générateur.
  // Sans ce binding, l'ingestion utilise un générateur heuristique local, hors
  // ligne, sans compte Cloudflare.
  // "ai": { "binding": "AI" },

  "observability": {
    "enabled": true
  }
}
