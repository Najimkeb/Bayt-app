{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayt-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // Requis par Better Auth (crypto/hachage de mots de passe côté Node).
  "compatibility_flags": ["nodejs_compat"],

  // Base D1 du contexte « Learning Engine ».
  // `database_id` n'est utilise qu'en remote : en local, wrangler cree une base
  // SQLite sous .wrangler/state/ — aucun compte Cloudflare requis.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bayt",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations"
    }
  ],

  // R2 retiré : tant que l'abonnement R2 n'est pas actif, le texte extrait des
  // documents est stocké dans D1 (`documents.extracted_text`) via le port
  // `DocumentStorage`. R2 reste la cible (cf. lessons.md L031) — on rebranchera
  // un binding + une implémentation `R2DocumentStorage` sans toucher au pipeline.

  // Queues : traitement asynchrone de l'ingestion, hors du chemin critique.
  // Le même Worker est producteur (POST /documents) et consommateur (queue()).
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "bayt-ingestion"
      }
    ],
    "consumers": [
      {
        "queue": "bayt-ingestion",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  // Workers AI : branche le vrai générateur de cartes (agent LLM).
  // Le binding `AI` expose les modèles Workers AI sur l'infra Cloudflare (aucune
  // clé externe). En `wrangler dev`, les appels sont relayés vers Workers AI en
  // remote : il faut donc être authentifié (`wrangler login`).
  // Retirer ce binding fait retomber l'ingestion sur le générateur heuristique
  // local (hors ligne) — le repli reste fonctionnel (cf. src/index.ts).
  "ai": { "binding": "AI" },

  "observability": {
    "enabled": true
  },

  // ─── Production ───────────────────────────────────────────────────────────
  // Déployé avec `wrangler deploy --env production`. Le top-level ci-dessus reste
  // la config de DEV LOCAL (localhost) ; l'environnement `production` redéclare
  // toutes les ressources (les bindings ne sont pas hérités) avec leurs vrais
  // identifiants, le domaine personnalisé et les URLs de prod.
  "env": {
    "production": {
      "vars": {
        "WEB_ORIGIN": "https://bayt.app",
        "BETTER_AUTH_URL": "https://api.bayt.app",
        "COOKIE_DOMAIN": ".bayt.app"
      },
      // Le domaine personnalisé `api.bayt.app` est attaché manuellement dans le
      // dashboard (Workers & Pages → bayt-api-production → Custom Domains). Les
      // `vars` ci-dessus pointent déjà vers les URLs de prod finales.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bayt-prod",
          "database_id": "ff0e8877-dcd4-482e-a019-999ca45f50f1",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "INGESTION_QUEUE", "queue": "bayt-ingestion" }],
        "consumers": [
          {
            "queue": "bayt-ingestion",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3
          }
        ]
      },
      "kv_namespaces": [{ "binding": "KV", "id": "bd02ee04c2884473ac54ab41259e5328" }],
      "ai": { "binding": "AI" }
    }
  }
}
