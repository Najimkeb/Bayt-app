{
  "name": "@bayt/api",
  "version": "0.1.0",
  "private": true,
  "description": "Worker Cloudflare + Hono — API de revision (D1 + Drizzle)",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bayt --local",
    "db:seed:local": "wrangler d1 execute bayt --local --file=./seed/demo.sql",
    "db:reset:local": "wrangler d1 migrations apply bayt --local && wrangler d1 execute bayt --local --file=./seed/demo.sql"
  },
  "dependencies": {
    "@bayt/domain": "workspace:*",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bayt/config": "workspace:*",
    "@cloudflare/workers-types": "^5.20260722.1",
    "drizzle-kit": "^0.31.10",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.113.0"
  }
}
