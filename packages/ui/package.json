{
  "name": "@bayt/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Composants partages BAYT (shadcn/ui + Tailwind)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@bayt/config": "workspace:*",
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
